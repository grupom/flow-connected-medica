# ──────────────────────────────────────────────────────────────────────────────
# ClinicQueue — Docker Compose configuration
# Copiar este archivo a .env y ajustar los valores antes de ejecutar:
#   cp .env.docker.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# IMPORTANTE: POSTGRES_USER debe ser "postgres".
# El schema DDL usa "OWNER TO postgres" en todos los objetos.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=clinicqueue_db

# ── API ───────────────────────────────────────────────────────────────────────
# El hostname "postgres" es el nombre del servicio en docker-compose.yml.
# IMPORTANTE: no usar # en la contraseña — es un carácter reservado en URLs.
DATABASE_URL=postgresql://postgres:change_me_strong_db_password@postgres:5432/clinicqueue_db

# Generar valores aleatorios (mínimo 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(40).toString('hex'))"
JWT_SECRET=change_me_random_access_secret_minimum_32_characters_here
JWT_REFRESH_SECRET=change_me_random_refresh_secret_minimum_32_chars_here

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS: vacío = el UI se sirve desde el mismo origen que el API → no se necesita.
# Completar solo si hay otros frontends externos que consuman el API.
CORS_ORIGIN=
CORS_SUBNETS=
# CORS_TRUST_LAN=true confiaría en cualquier dispositivo de la red privada del
# sitio, no solo los equipos de la clínica. Dejar vacío/false salvo que un sitio
# puntual lo necesite explícitamente — usar CORS_ORIGIN/CORS_SUBNETS primero.
CORS_TRUST_LAN=

# COOKIE_SECURE=true agrega el atributo "Secure" a las cookies de sesión —
# solo activarlo si hay HTTPS (reverse-proxy) delante de este contenedor.
# Dejar vacío/false para el despliegue HTTP plano en la LAN de la clínica.
COOKIE_SECURE=

LOG_LEVEL=info

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@clinicqueue.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# ── Puertos expuestos en el host ──────────────────────────────────────────────
# Cambiar si ya están ocupados en el servidor.
API_PORT=3001
PGADMIN_PORT=5050
