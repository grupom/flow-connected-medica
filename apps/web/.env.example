# ──────────────────────────────────────────────────────────────
# PUBLIC_API_URL — URL base del API
# ──────────────────────────────────────────────────────────────
#
# PRODUCCIÓN (API sirve el UI en el mismo puerto):
#   Dejar vacío → la app usa rutas relativas (/api/...) sin CORS.
PUBLIC_API_URL=
#
# DESARROLLO STANDALONE (web en :5173, api en :3001):
#   El proxy de Vite ya redirige /api → localhost:3001, así que
#   tampoco hace falta cambiar este valor normalmente.
#   Sólo descomentar si no quieres usar el proxy:
# PUBLIC_API_URL=http://localhost:3001
