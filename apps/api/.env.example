# API Environment Variables — copiar a .env y completar
# ─────────────────────────────────────────────────────

# Base de datos PostgreSQL
DATABASE_URL=postgresql://sys_planning:sys_planning_2022@localhost:5432/fc_medica

# JWT — usar secretos aleatorios de al menos 32 caracteres en producción
JWT_SECRET=change_me_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Servidor
PORT=3001
HOST=0.0.0.0

# CORS — orígenes permitidos (separados por coma)
# En producción el UI se sirve desde el mismo puerto → CORS sólo necesario para
# accesos externos (herramientas de admin, otros frontends, etc.)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# CORS_SUBNETS — prefijos de IP de redes internas a las que se permite el acceso
# (opcional; separar por coma, ej: "172.16.,10.25.1.,192.168.")
CORS_SUBNETS=

# CORS_TRUST_LAN — opt-in (default false/vacío). Si se pone en "true", confía en
# CUALQUIER dispositivo de la red privada (RFC1918), no solo los equipos de la
# clínica. La mayoría de instalaciones NO lo necesitan (UI+API van en el mismo
# origen en producción, y CORS_ORIGIN ya cubre el desarrollo local). Usar
# CORS_ORIGIN o CORS_SUBNETS para agregar un origen/subred puntual en vez de
# activar esto.
CORS_TRUST_LAN=

# COOKIE_SECURE — opt-in (default false/vacío). Agrega el atributo "Secure" a
# las cookies de sesión (accessToken/refreshToken), que el navegador deja de
# enviar si no hay HTTPS. Dejar vacío/false salvo que haya un reverse-proxy
# con TLS delante — de lo contrario el login se rompe silenciosamente.
COOKIE_SECURE=

# Entorno
NODE_ENV=development
